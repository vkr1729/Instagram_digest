# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=instagram-digest
R2_PUBLIC_DOMAIN=https://pub-yourdomain.r2.dev

# GitHub Deployment
GH_PAGES_REPO=https://github.com/vkr1729/Instagram_digest.git

# Pipeline & Retention Settings
RETENTION_WEEKS=1
RETENTION_DAYS=8
DEFAULT_PLAYBACK_SPEED=1.25
TOP_DIGEST_COUNT=200
MAX_PER_CREATOR=4

# Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
