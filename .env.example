# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=instagram-digest
R2_PUBLIC_DOMAIN=https://pub-yourdomain.r2.dev

# GitHub Deployment
GH_PAGES_REPO=https://github.com/vkr1729/Instagram_digest.git

# Pipeline & Retention Settings
RETENTION_WEEKS=1
RETENTION_DAYS=8
DEFAULT_PLAYBACK_SPEED=1.25
TOP_DIGEST_COUNT=250
MAX_PER_CREATOR=4

# Tier 3 external-discovery guardrails (fresh-account protection)
MAX_EXTERNAL_SHARE=0.40
MAX_FEED_EVALUATIONS=1000
MIN_EXTERNAL_LIKES=25000
MIN_EXTERNAL_COMMENTS=150

# Fresh-account trust guardrails
FOLLOW_COOLDOWN_HOURS=48
FOLLOW_BURST_THRESHOLD=20
# TRUST_WARMING: 1 forces doubled pacing on, 0 forces off, empty = auto (<14d past first follow burst)
TRUST_WARMING=

# Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
