[Unit]
Description=Saturday evening chain: Instagram Digest then TubeLM, then power off

[Timer]
OnCalendar=Sat *-*-* 18:00:00
AccuracySec=1m
# A Saturday evening the machine is off/asleep fires on next login/boot
# (weekend catch-up); the wrapper skips shutdown for those morning runs.
Persistent=true

[Install]
WantedBy=timers.target
